{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeMie Connect",
  "version": "2.0.1",
  "identifier": "com.epam.codemie.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EPAM AI/Run CodeMie Connect",
        "width": 1000,
        "height": 660,
        "resizable": false,
        "fullscreen": false,
        "backgroundColor": "#1A1A1A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "resources": [
      { "src": "../assets/windows/bin/codemie.cmd", "target": "bin/codemie.cmd" },
      { "src": "../assets/windows/node/node.exe",   "target": "node/node.exe" },
      { "src": "../assets/windows/cli",             "target": "cli" }
    ],
    "category": "DeveloperTool",
    "copyright": "EPAM AI/Run CodeMie ©",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
