+pub async fn pty_kill(state: State<'_, AppState>) -> CmdResult<()> {
+    let (killer_arc, exit_cv) = {
+        let guard = state.pty.lock().unwrap();
+        match guard.as_ref() {
+            Some((_, h)) => (Arc::clone(&h.killer), Arc::clone(&h.exit_cv)),
+            None => return Ok(()), // nothing running — no-op
