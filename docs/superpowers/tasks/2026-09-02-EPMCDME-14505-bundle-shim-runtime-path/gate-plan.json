{
  "schema": 1,
  "runner": "custom",
  "gates": [
    {
      "id": "fmt",
      "command": "cd src-tauri && cargo fmt --check",
      "source": "guide"
    },
    {
      "id": "lint",
      "command": "cd src-tauri && cargo clippy -- -D warnings",
      "source": "guide"
    },
    {
      "id": "unit-js",
      "command": "npm test",
      "source": "guide"
    },
    {
      "id": "unit-rust",
      "command": "cd src-tauri && cargo test",
      "source": "guide"
    },
    {
      "id": "build",
      "command": "cd src-tauri && CI=true cargo tauri build",
      "source": "guide"
    }
  ],
  "ui_globs": [
    "\\.(tsx|jsx|css|html|vue|svelte)$",
    "src/(ui|frontend|components)/",
    "^ui/"
  ],
  "detected_at": "2026-09-03T00:00:00.000Z"
}
