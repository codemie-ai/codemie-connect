+        let pair2 = Arc::clone(&pair);
+        std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(50));
+            let (lk, cv) = &*pair2;
+            *lk.lock().unwrap() = true;
+            cv.notify_all();
+        });
+        let (lk, cv) = &*pair;
+        let guard = lk.lock().unwrap();
