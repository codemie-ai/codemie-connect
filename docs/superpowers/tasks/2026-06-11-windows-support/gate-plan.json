{
  "schema": 1,
  "runner": "custom",
  "source": ".ai-run/guides/quality-gates.md",
  "gates": [
    {"id": "fmt",     "command": "cd src-tauri && cargo fmt --check", "available": true},
    {"id": "lint",    "command": "cd src-tauri && cargo clippy -- -D warnings", "available": true},
    {"id": "unit-js", "command": "npm test", "available": true, "skip_if": "Rust-only changes"},
    {"id": "unit-rs", "command": "cd src-tauri && cargo test", "available": true},
    {"id": "build",   "command": "cd src-tauri && CI=true cargo tauri build", "available": true, "skip_if": "logic-only change verified by tests"}
  ],
  "ui_globs": ["\\.(tsx|jsx|css|html|vue|svelte)$", "src/(ui|frontend|components)/", "ui/"],
  "detected_at": "2026-06-11T00:00:00Z"
}
